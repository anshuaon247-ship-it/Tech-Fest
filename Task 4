<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task 4: Ideate Landing Page Blueprint</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 font-mono antialiased min-h-screen p-6 md:p-12">

  <div class="max-w-4xl mx-auto space-y-10">
    
    <!-- Header -->
    <div class="border-b border-cyan-900/60 pb-6 flex justify-between items-center">
      <div>
        <span class="text-xs font-bold text-cyan-400 tracking-widest bg-cyan-950 px-3 py-1 rounded-full border border-cyan-800">[ TASK 4: IDEATION & ARCHITECTURE ]</span>
        <h1 class="text-3xl font-extrabold text-white mt-3">CYBORG-01 // LANDING PAGE CONCEPT BLUEPRINT</h1>
      </div>
      <i class="fa-solid fa-compass-drafting text-cyan-400 text-3xl"></i>
    </div>

    <!-- 1. Executive Summary & Vision -->
    <section class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
      <h2 class="text-lg font-bold text-cyan-400 mb-3 flex items-center gap-2">
        <i class="fa-solid fa-lightbulb text-sm"></i> 1. Core Vision & Theme Ideation
      </h2>
      <p class="text-xs text-slate-300 leading-relaxed">
        The project ideation merges futuristic cybernetics with interactive WebGL rendering. The goal is to build an immersive portal showcasing bionic hardware integration (ocular, neural, and kinetic modules) using high-contrast neon accents, glassmorphic UI elements, and continuous 3D telemetry feedback.
      </p>
    </section>

    <!-- 2. UI/UX Wireframe & Structure -->
    <section class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
      <h2 class="text-lg font-bold text-cyan-400 mb-4 flex items-center gap-2">
        <i class="fa-solid fa-sitemap text-sm"></i> 2. Page Wireframe & Layout Architecture
      </h2>
      
      <div class="space-y-3 text-xs">
        <div class="p-4 bg-slate-950 border border-cyan-900/50 rounded-lg flex items-center justify-between">
          <div>
            <span class="text-cyan-400 font-bold">SECTION A: Hero / Neural Initialization</span>
            <p class="text-slate-400 text-[11px] mt-0.5">High-impact typography, system status badge, CTA buttons, and floating 3D wireframe core.</p>
          </div>
          <span class="text-[10px] bg-slate-800 px-2 py-1 rounded text-slate-300">Phase 1</span>
        </div>

        <div class="p-4 bg-slate-950 border border-cyan-900/50 rounded-lg flex items-center justify-between">
          <div>
            <span class="text-cyan-400 font-bold">SECTION B: Bionic Integration Modules</span>
            <p class="text-slate-400 text-[11px] mt-0.5">3-column glassmorphism grid highlighting Ocular Matrix, Neural Core, and Kinetic Chassis.</p>
          </div>
          <span class="text-[10px] bg-slate-800 px-2 py-1 rounded text-slate-300">Phase 2</span>
        </div>

        <div class="p-4 bg-slate-950 border border-cyan-900/50 rounded-lg flex items-center justify-between">
          <div>
            <span class="text-cyan-400 font-bold">SECTION C: Live Diagnostics & Telemetry</span>
            <p class="text-slate-400 text-[11px] mt-0.5">Real-time status indicators, temperature gauges, and interactive scroll-triggered depth transformations.</p>
          </div>
          <span class="text-[10px] bg-slate-800 px-2 py-1 rounded text-slate-300">Phase 3</span>
        </div>
      </div>
    </section>

    <!-- 3. Technical Stack & Design System -->
    <section class="grid md:grid-cols-2 gap-6">
      
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
        <h3 class="text-sm font-bold text-cyan-400 mb-3 flex items-center gap-2">
          <i class="fa-solid fa-palette text-xs"></i> Design System Palette
        </h3>
        <div class="grid grid-cols-2 gap-2 text-[11px]">
          <div class="p-2 bg-slate-950 rounded border border-slate-800 text-slate-300">
            <span class="block w-3 h-3 rounded-full bg-cyan-400 mb-1"></span>
            Cyan Glow (#00f2fe)
          </div>
          <div class="p-2 bg-slate-950 rounded border border-slate-800 text-slate-300">
            <span class="block w-3 h-3 rounded-full bg-slate-950 border border-slate-700 mb-1"></span>
            Slate Dark (#020617)
          </div>
        </div>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
        <h3 class="text-sm font-bold text-cyan-400 mb-3 flex items-center gap-2">
          <i class="fa-solid fa-code text-xs"></i> Tech Stack Selection
        </h3>
        <ul class="text-[11px] space-y-1.5 text-slate-300">
          <li>• <strong class="text-white">Three.js:</strong> WebGL 3D rendering engine</li>
          <li>• <strong class="text-white">Tailwind CSS:</strong> Futuristic utility-first styling</li>
          <li>• <strong class="text-white">JavaScript:</strong> Dynamic scroll depth & parallax event handlers</li>
        </ul>
      </div>

    </section>

  </div>

</body>
</html>
